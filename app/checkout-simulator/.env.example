# Copy to .env and fill in. Never commit .env.
APP_MODE=mock                 # mock | live
FABRIC_AUTH=sp                # sp (ClientSecretCredential) | cli (AzureCliCredential, after: az login --allow-no-subscriptions)

# Lab 4 - Entra app registration sp-brightcart-checkout-app (Contributor on the workspace)
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=
FABRIC_WORKSPACE_ID=
FABRIC_MODEL_ID=
FABRIC_MODEL_VERSION=         # blank = default version (Manage endpoints); e.g. 1 pins /versions/1/score

# Lab 5 - eventstream es_checkout_events, Custom endpoint source, Event Hub protocol
EVENTSTREAM_CONNECTION_STRING=   # Endpoint=sb://eventstream-...;SharedAccessKeyName=...;SharedAccessKey=...;EntityPath=es_...
EVENTSTREAM_ENTITY_NAME=         # only needed if the connection string has no EntityPath
